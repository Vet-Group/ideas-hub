# Copy to .env for local development. Values here are local-only placeholders, never real secrets.
DATABASE_URL=postgres://ideashub:ideashub-local-only@127.0.0.1:5433/ideashub

# MinIO from docker-compose.yml (API 9300, console 9301).
S3_ENDPOINT=http://127.0.0.1:9300
S3_ACCESS_KEY=ideashub
S3_SECRET_KEY=ideashub-local-only
S3_BUCKET=ideas-hub

# Web app (port 3300). Public URL is the origin checked by the upload route.
APP_URL=http://localhost:3300
BETTER_AUTH_SECRET=
THUMB_URL_SECRET=

# OpenAI-compatible endpoint; the model name comes from admin settings only.
LLM_BASE_URL=
LLM_API_KEY=

# Ideas Hub's own Lark bot app. Without the id and secret nothing is posted; Alerts stay on the admin page.
LARK_APP_ID=
LARK_APP_SECRET=
# Lark Open API origin (default https://open.larksuite.com; tests point it at a local fake server).
LARK_BASE_URL=
# Chat ids: the shared group that gets the global briefing, and the admin chat that gets Alerts.
# Store chats are set per store (stores.lark_chat_id).
LARK_SHARED_CHAT_ID=
LARK_ADMIN_CHAT_ID=

# Crawler browser mode: headed, offscreen or headless (default: the Step 1 choice).
IDEAS_HUB_BROWSER_MODE=
