{
  "name": "ideas-hub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "^22.12.0 || ^24 || >=26"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "db:generate": "pnpm --filter @ideas-hub/db generate",
    "db:migrate": "pnpm --filter @ideas-hub/db migrate",
    "db:seed": "pnpm --filter @ideas-hub/db seed",
    "worker": "pnpm --filter @ideas-hub/worker start",
    "crawl:run": "pnpm --filter @ideas-hub/worker crawl:run",
    "watchdog": "pnpm --filter @ideas-hub/worker watchdog",
    "briefing:build": "pnpm --filter @ideas-hub/worker briefing:build",
    "briefing:preview": "tsx scripts/briefing-preview.ts",
    "ops:alert": "tsx apps/worker/src/ops-cli.ts alert",
    "ops:quiet": "tsx apps/worker/src/ops-cli.ts quiet",
    "ro-query": "tsx apps/worker/src/ops-cli.ts ro-query",
    "lark:post": "tsx apps/worker/src/ops-cli.ts lark-post"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@ideas-hub/core": "workspace:*",
    "@ideas-hub/db": "workspace:*",
    "@types/node": "24.19.0",
    "drizzle-orm": "0.45.3",
    "eslint": "10.12.0",
    "globals": "17.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  }
}
