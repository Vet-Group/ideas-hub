#!/usr/bin/env bash
# ideashub-backup: the daily off-host backup and its restore drill (ADR 0007, phase 2 plan Step 2c), run
# as the host user by ideashub-backup.timer (08:30) and ideashub-backup-drill.timer (the 1st, 09:30).
#   ideashub-backup          pg_dump and counts.txt to the staging directory; restic backup of it and the
#                            MinIO volume to the off-host bucket (Cloudflare R2, ADR 0007 D3 reversed);
#                            forget snapshots older than OFFSITE_RETENTION_DAYS (prune on Sundays)
#   ideashub-backup --drill  restore the latest snapshot into a temporary database and a temporary MinIO,
#                            compare with its counts.txt (ok/DIFF per line), remove both
# restic runs in the restic/restic image pinned below, with the cache volume ideas-hub_restic-cache.
# Environment (~/.config/ideas-hub/backup.env, chmod 600, read by the units):
#   OFFSITE_S3_ENDPOINT, OFFSITE_S3_BUCKET, OFFSITE_S3_ACCESS_KEY_ID, OFFSITE_S3_SECRET_ACCESS_KEY  the R2
#     bucket (S3 API); OFFSITE_S3_PREFIX (default ideas-hub), OFFSITE_S3_REGION (default auto) and
#     OFFSITE_RETENTION_DAYS (default 30) are optional
#   RESTIC_PASSWORD_FILE  the client-side encryption key (required once the bucket is set)
#   RESTIC_REPOSITORY (+ AWS_*)  any other restic repository, instead of OFFSITE_S3_*
# With neither set the run logs one line and exits 0 (no off-host backup configured).
# IDEASHUB_REPO (default: the checkout holding this script); IDEASHUB_ALERT_KEY replaces the date in the
# Alert key (tests and the Step 5 check pass test:<timestamp>).
# Every failure writes a backup_failed ops Alert keyed <date>:<stage>; the watchdog posts it.
# Exit: 0 done; 1 failed (Alerted).
set -Eeuo pipefail

repo="${IDEASHUB_REPO:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)}"
state="$HOME/.local/state/ideas-hub"
staging="$state/backup-staging"
restic_image="restic/restic:0.19.1@sha256:136600b6ff6843d61d355f7f71f460a166429f35de6fd11b568fece3c9a4d510"
compose=(docker compose -p ideas-hub -f "$repo/docker-compose.yml")
check_db=ideashub_restore_check
drill_name=ideas-hub-drill-minio
drill_volume=ideas-hub_drill-minio

mkdir -p "$state"
exec > >(tee -a "$state/backup.log") 2>&1

say() { printf '%s [backup] %s\n' "$(date -u +%FT%TZ)" "$*"; }
fail() { # $1 = stage, $2 = short error
  say "failed at $1: $2"
  (cd "$repo" && pnpm --silent ops:alert backup_failed "${IDEASHUB_ALERT_KEY:-$(date -u +%F)}:$1" "backup failed at $1: $2") ||
    say "warning: the Alert could not be written"
  exit 1
}

drill=0
case "${1:-}" in
  --drill) drill=1 ;;
  "") ;;
  -h | --help) sed -n '2,21p' "$0"; exit 0 ;;
  *) sed -n '4,7p' "$0" >&2; exit 2 ;;
esac

cd "$repo"

# The off-host target. OFFSITE_S3_* become restic's repository and keys; a partial set is a config error.
if [ -n "${OFFSITE_S3_ENDPOINT:-}${OFFSITE_S3_BUCKET:-}${OFFSITE_S3_ACCESS_KEY_ID:-}${OFFSITE_S3_SECRET_ACCESS_KEY:-}" ]; then
  for v in OFFSITE_S3_ENDPOINT OFFSITE_S3_BUCKET OFFSITE_S3_ACCESS_KEY_ID OFFSITE_S3_SECRET_ACCESS_KEY; do
    [ -n "${!v:-}" ] || fail config "$v is not set (~/.config/ideas-hub/backup.env)"
  done
  export RESTIC_REPOSITORY="s3:${OFFSITE_S3_ENDPOINT%/}/$OFFSITE_S3_BUCKET/${OFFSITE_S3_PREFIX:-ideas-hub}"
  export AWS_ACCESS_KEY_ID="$OFFSITE_S3_ACCESS_KEY_ID" AWS_SECRET_ACCESS_KEY="$OFFSITE_S3_SECRET_ACCESS_KEY"
  export AWS_DEFAULT_REGION="${OFFSITE_S3_REGION:-auto}"
fi
if [ -z "${RESTIC_REPOSITORY:-}" ]; then
  say "no off-host target configured (OFFSITE_S3_* unset); nothing to do"
  exit 0
fi
[ -r "${RESTIC_PASSWORD_FILE:-}" ] || fail config "RESTIC_PASSWORD_FILE is not a readable file (~/.config/ideas-hub/backup.env)"
retention_days="${OFFSITE_RETENTION_DAYS:-30}"
[[ "$retention_days" =~ ^[1-9][0-9]*$ ]] || fail config "OFFSITE_RETENTION_DAYS must be a positive whole number"

bucket="$(sed -n 's/^S3_BUCKET=//p' .env 2>/dev/null | tr -d '\r"')" || true
bucket="${bucket:-ideas-hub}"
# The MinIO image docker-compose.yml pins, for the drill's temporary MinIO.
minio_image="$(sed -n 's/^ *image: *\(chainguard\/minio@sha256:[0-9a-f]*\).*/\1/p' docker-compose.yml)"

# One ops job at a time (deploy, retention and this); a deploy takes at most 30 minutes.
exec 9>"$state/ops.lock"
flock -w 2400 9 || fail lock "ops.lock still held after 40 minutes"

# restic in its pinned image; the password file and the repository keys stay out of the command line.
mounts=()
restic() {
  docker run --rm --cpus 1 --memory 1g \
    -e RESTIC_REPOSITORY -e AWS_ACCESS_KEY_ID -e AWS_SECRET_ACCESS_KEY -e AWS_DEFAULT_REGION \
    -e RESTIC_PASSWORD_FILE=/run/restic-password -v "$RESTIC_PASSWORD_FILE:/run/restic-password:ro" \
    -e RESTIC_CACHE_DIR=/cache -v ideas-hub_restic-cache:/cache "${mounts[@]}" "$restic_image" "$@"
}
# The last line of a failed command's output, for the Alert.
last_line() { printf '%s' "$1" | tr -d '\r' | sed '/^$/d' | tail -n 1; }
# mc inside a MinIO container, against that container's own server with its own root credentials.
mc_in() { docker exec "$1" sh -c 'MC_HOST_ih="http://$MINIO_ROOT_USER:$MINIO_ROOT_PASSWORD@127.0.0.1:9000" exec mc "$@"' mc "${@:2}"; }
# "<objects> <bytes>" of the bucket in a MinIO container.
bucket_counts() {
  mc_in "$1" ls --recursive --json "ih/$bucket" |
    awk '/"type":"file"/ { n++; if (match($0, /"size":[0-9]+/)) b += substr($0, RSTART + 7, RLENGTH - 7) } END { printf "%d %.0f\n", n, b }'
}

if [ "$drill" = 0 ]; then
  # A database a failed deploy restore left broken is never snapshotted over the good ones.
  [ ! -e "$state/restore-failed" ] || fail sentinel "$state/restore-failed exists; no backup until a person restores the database"

  # 1. Dump and counts. The row counts come from the dump itself, so they match it exactly.
  rm -rf "$staging"
  mkdir -p "$staging"
  "${compose[@]}" exec -T postgres pg_dump -U ideashub -d ideashub -Fc > "$staging/ideashub.dump" || fail dump "pg_dump failed"
  "${compose[@]}" exec -T postgres pg_restore --data-only -f - < "$staging/ideashub.dump" |
    awk '/^COPY / { t = $2; n = 0; next } t != "" && /^\\\.$/ { print "rows", t, n; t = ""; next } t != "" { n++ }' \
      > "$staging/counts.txt" || fail counts "reading the dump's row counts failed"
  grep -q '^rows ' "$staging/counts.txt" || fail counts "the dump holds no table"
  minio="$("${compose[@]}" ps -q minio)" || minio=""
  [ -n "$minio" ] || fail counts "the minio container is not running"
  objects="$(bucket_counts "$minio")" || fail counts "listing bucket $bucket failed"
  echo "objects $bucket $objects" >> "$staging/counts.txt"
  say "dumped: $(grep -c '^rows ' "$staging/counts.txt") tables, $(sed -n 's/^objects [^ ]* //p' "$staging/counts.txt") (objects bytes)"

  # 2. Snapshot. The fixed --host keeps the parent snapshot (incremental) and one forget group. A failure
  # leaves the staging directory and every earlier snapshot as they are; the next run tries again.
  restic cat config > /dev/null 2>&1 || {
    out="$(restic init 2>&1)" || { printf '%s\n' "$out"; fail init "$(last_line "$out")"; }
    say "initialised the off-host repository"
  }
  mounts=(-v "$staging:/backup/staging:ro" -v ideas-hub_minio-data:/backup/minio:ro)
  out="$(restic backup --host ideashub /backup 2>&1)" || { printf '%s\n' "$out"; fail backup "$(last_line "$out")"; }
  printf '%s\n' "$out" | tail -n 3
  mounts=()

  # 3. Retention: snapshots older than the window go; pruning rewrites packs, so only once a week.
  prune=()
  [ "$(date +%u)" != 7 ] || prune=(--prune)
  out="$(restic forget --host ideashub --keep-within "${retention_days}d" "${prune[@]}" 2>&1)" ||
    { printf '%s\n' "$out"; fail forget "$(last_line "$out")"; }
  rm -rf "$staging"
  say "backup done${prune:+ (pruned)}"
  exit 0
fi

# --drill: everything temporary is removed on any exit, and before the start (a killed earlier drill).
cleanup() {
  "${compose[@]}" exec -T postgres dropdb -U ideashub --if-exists --force "$check_db" || say "warning: could not drop $check_db"
  docker rm -f "$drill_name" > /dev/null 2>&1 || true
  docker volume rm -f "$drill_volume" > /dev/null 2>&1 || true
}
cleanup
trap cleanup EXIT

snap="$(restic snapshots --host ideashub --latest 1 --json 2>&1)" || fail drill "$(last_line "$snap")"
snap="$(printf '%s' "$snap" | grep -o '"short_id":"[0-9a-f]*"' | head -n 1 | cut -d'"' -f4)" || true
[ -n "$snap" ] || fail drill "no snapshot of host ideashub in the repository"
say "drill of snapshot $snap"
expected="$(restic dump "$snap" /backup/staging/counts.txt)" || fail drill "counts.txt not in snapshot $snap"

"${compose[@]}" exec -T postgres createdb -U ideashub -O ideashub "$check_db" || fail drill "createdb $check_db failed"
restic dump "$snap" /backup/staging/ideashub.dump |
  "${compose[@]}" exec -T postgres pg_restore -U ideashub -d "$check_db" --no-owner --exit-on-error ||
  fail drill "pg_restore of snapshot $snap failed"

mounts=(-v "$drill_volume:/target")
out="$(restic restore "$snap:/backup/minio" --target /target 2>&1)" || { printf '%s\n' "$out"; fail drill "$(last_line "$out")"; }
mounts=()
# Root inside the container: the restored files keep the owner of the original volume. No port is published.
MINIO_ROOT_USER=drill MINIO_ROOT_PASSWORD="$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')"
export MINIO_ROOT_USER MINIO_ROOT_PASSWORD
docker run -d --name "$drill_name" --user 0 --cpus 0.5 --memory 512m -e MINIO_ROOT_USER -e MINIO_ROOT_PASSWORD \
  -v "$drill_volume:/data" "$minio_image" server /data > /dev/null || fail drill "the temporary MinIO did not start"
for ((i = 0; i < 30; i++)); do mc_in "$drill_name" ready ih > /dev/null 2>&1 && break; sleep 2; done

diffs=0
while read -r kind name n bytes; do
  case "$kind" in
    rows)
      got="$("${compose[@]}" exec -T postgres psql -U ideashub -d "$check_db" -AtX -v ON_ERROR_STOP=1 -c "select count(*) from $name" 2>&1 < /dev/null)" || got="error"
      want="$n" ;;
    objects)
      got="$(bucket_counts "$drill_name" 2>&1)" || got="error"
      want="$n $bytes" ;;
    *) continue ;;
  esac
  if [ "$got" = "$want" ]; then
    echo "ok   $kind $name $got"
  else
    echo "DIFF $kind $name restored ${got//$'\n'/ }, snapshot $want"
    diffs=$((diffs + 1))
  fi
done <<< "$expected"
[ "$diffs" = 0 ] || fail drill "$diffs line(s) of snapshot $snap differ from its counts.txt"
say "drill of snapshot $snap ok"
