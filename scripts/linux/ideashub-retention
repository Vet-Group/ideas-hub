#!/usr/bin/env bash
# ideashub-retention: one data-retention pass (ADR 0007, phase 2 plan Step 2b), started daily at 09:00 by
# ideashub-retention.timer as the ideashub user. Waits for ops.lock (deploy, backup and the drill take it
# too), then runs `pnpm retention`, which writes its own retention_failed Alert on an error. This script
# writes one too when the lock stays held or the pass dies before it can; both use the UTC date as the
# key, so a day never gets two.
# Environment: IDEASHUB_REPO (default: the checkout holding this script), IDEASHUB_LOCK_WAIT (seconds,
# default 3600).
# Exit: 0 done; 1 not done (Alert written when the database is reachable).
set -uo pipefail

repo="${IDEASHUB_REPO:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)}"
state="$HOME/.local/state/ideas-hub"
mkdir -p "$state"
cd "$repo" || exit 1

say() { printf '%s [retention] %s\n' "$(date -u +%FT%TZ)" "$*"; }
alert() {
  pnpm --silent ops:alert retention_failed "$(date -u +%F)" "$1" || say "warning: the Alert could not be written"
}

exec 9>"$state/ops.lock"
if ! flock -w "${IDEASHUB_LOCK_WAIT:-3600}" 9; then
  say "ops.lock still held after ${IDEASHUB_LOCK_WAIT:-3600} s; no retention today"
  alert "ops.lock still held after ${IDEASHUB_LOCK_WAIT:-3600} s; retention skipped today"
  exit 1
fi
rc=0
pnpm --silent retention || rc=$?
[ "$rc" = 0 ] && exit 0
say "pnpm retention exited $rc"
alert "retention exited $rc; see journalctl --user -u ideashub-retention"
exit 1
